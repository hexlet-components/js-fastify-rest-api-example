{
  "name": "catalog-contract-first",
  "version": "1.0.0",
  "description": "",
  "scripts": {
    "generate": "npm run generate:main && npm run generate:minimal && npm run generate:crud && npm run generate:versions && npm run generate:webhooks",
    "check": "tsc --noEmit",
    "test": "npm run generate && npm run check && node --test test/*.test.ts starters/crud/api.test.ts versions/api.test.ts",
    "start": "node src/start.ts",
    "token": "node scripts/token.ts",
    "receiver": "node scripts/receiver.ts",
    "compatibility": "node scripts/compatibility.ts",
    "contract": "node scripts/contract.ts",
    "generate:minimal": "tsp compile starters/minimal && openapi-ts -f starters/minimal/openapi-ts.config.ts",
    "start:minimal": "node starters/minimal/app.ts",
    "generate:crud": "tsp compile starters/crud && openapi-ts -f starters/crud/openapi-ts.config.ts",
    "start:crud": "node starters/crud/app.ts",
    "test:crud": "npm run generate:crud && npm run check && node --test starters/crud/api.test.ts",
    "generate:versions": "tsp compile versions && openapi-ts -f versions/openapi-ts.config.ts",
    "start:versions": "node versions/app.ts",
    "test:versions": "npm run generate:versions && node --test versions/api.test.ts",
    "generate:main": "tsp compile . && openapi-ts",
    "generate:webhooks": "tsp compile webhooks && openapi-ts -f webhooks/openapi-ts.config.ts",
    "start:setup": "node starters/setup.ts",
    "migrate": "node scripts/migrate.ts",
    "seed:pagination": "node scripts/seed-pagination.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@fastify/response-validation": "3.0.5",
    "@hey-api/openapi-ts": "0.99.0",
    "@types/node": "26.6.6",
    "@typespec/compiler": "1.18.0",
    "@typespec/http": "1.18.0",
    "@typespec/openapi": "1.18.0",
    "@typespec/openapi3": "1.18.0",
    "ajv-formats": "3.0.1",
    "fastify": "5.12.8",
    "fastify-openapi-glue": "4.12.0",
    "typescript": "6.0.3",
    "drizzle-orm": "0.45.2",
    "pg": "8.20.0",
    "@types/pg": "8.18.0",
    "@fastify/jwt": "10.2.2",
    "@fastify/rate-limit": "11.2.0",
    "fast-jwt": "6.3.7"
  },
  "private": true,
  "overrides": {
    "js-yaml": "4.3.2"
  }
}
