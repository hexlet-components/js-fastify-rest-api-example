{
  "type": "module",
  "name": "js-fastify-rest-api-example",
  "description": "REST API на Fastify: контракт на TypeSpec, типы и валидация из OpenAPI, Drizzle ORM.",
  "version": "1.0.0",
  "main": "src/app.ts",
  "imports": {
    "#src/*": "./src/*"
  },
  "engines": {
    "node": ">=26"
  },
  "directories": {
    "test": "test"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@fastify/autoload": "^6.5.1",
    "@fastify/cors": "^11.3.1",
    "@fastify/env": "^7.0.1",
    "@fastify/etag": "^6.2.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/jwt": "^10.2.5",
    "@fastify/otel": "^0.21.2",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/response-validation": "^3.0.5",
    "@fastify/sensible": "^6.0.7",
    "@fastify/under-pressure": "^9.2.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.223.0",
    "@opentelemetry/instrumentation-http": "^0.223.0",
    "@opentelemetry/sdk-node": "^0.223.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@scalar/fastify-api-reference": "^1.76.0",
    "@typespec/openapi": "^1.17.0",
    "ajv-formats": "^3.0.1",
    "drizzle-orm": "^0.45.4",
    "es-toolkit": "^1.52.0",
    "fastify": "^5.12.7",
    "fastify-cli": "^8.0.3",
    "fastify-metrics": "^14.1.0",
    "fastify-openapi-glue": "^4.12.0",
    "fastify-plugin": "^6.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@hey-api/openapi-ts": "0.99.0",
    "@redocly/cli": "^2.70.0",
    "@stoplight/prism-cli": "^5.16.0",
    "@typespec/compiler": "^1.17.0",
    "@typespec/http": "^1.17.0",
    "@typespec/json-schema": "^1.17.0",
    "@typespec/openapi3": "^1.17.0",
    "@typespec/rest": "^0.87.0",
    "@typespec/versioning": "^0.87.0",
    "@vitest/coverage-v8": "^5.0.5",
    "drizzle-kit": "^0.31.11",
    "globals": "^17.13.0",
    "npm-check-updates": "^23.1.1",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "pino-pretty": "^13.2.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "scripts": {
    "test": "vitest run",
    "start": "NODE_OPTIONS='--import ./src/telemetry.ts' fastify start -l info --plugin-timeout 60000 src/app.ts",
    "dev": "FASTIFY_AUTOLOAD_TYPESCRIPT=1 NODE_OPTIONS='--import ./src/telemetry.ts' fastify start -w -l info -P --plugin-timeout 60000 src/app.ts",
    "lint": "oxlint .",
    "lint:fix": "oxfmt . && oxlint --fix .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check ."
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@12.6.0"
}
