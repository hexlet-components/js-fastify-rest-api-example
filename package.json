{
  "type": "module",
  "name": "js-fastify-rest-api-example",
  "description": "REST API на Fastify: контракт на TypeSpec, типы и валидация из OpenAPI, Drizzle ORM.",
  "version": "1.0.0",
  "engines": {
    "node": ">=26"
  },
  "license": "ISC",
  "packageManager": "pnpm@12.6.0",
  "private": true,
  "dependencies": {
    "@fastify/response-validation": "3.0.5",
    "ajv-formats": "3.0.1",
    "fastify": "5.12.8",
    "fastify-openapi-glue": "4.12.0",
    "drizzle-orm": "0.45.4",
    "pg": "8.23.1",
    "@fastify/jwt": "10.2.8",
    "@fastify/rate-limit": "11.2.2",
    "fast-jwt": "6.3.7"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "0.99.0",
    "@types/node": "26.6.6",
    "@typespec/compiler": "1.18.0",
    "@typespec/http": "1.18.0",
    "@typespec/openapi": "1.18.0",
    "@typespec/openapi3": "1.18.0",
    "typescript": "6.0.3",
    "@types/pg": "8.23.1",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "@redocly/cli": "^2.78.0"
  },
  "scripts": {
    "generate": "pnpm run generate:main && pnpm run generate:minimal && pnpm run generate:crud && pnpm run generate:versions && pnpm run generate:webhooks",
    "check": "tsc --noEmit",
    "test": "pnpm run generate && pnpm run check && node --test test/*.test.ts starters/crud/api.test.ts versions/api.test.ts",
    "start": "node --env-file-if-exists=.env src/start.ts",
    "token": "node --env-file-if-exists=.env scripts/token.ts",
    "receiver": "node --env-file-if-exists=.env scripts/receiver.ts",
    "compatibility": "node --env-file-if-exists=.env scripts/compatibility.ts",
    "contract": "node --env-file-if-exists=.env scripts/contract.ts",
    "generate:minimal": "tsp compile starters/minimal && openapi-ts -f starters/minimal/openapi-ts.config.ts",
    "start:minimal": "node --env-file-if-exists=.env starters/minimal/app.ts",
    "generate:crud": "tsp compile starters/crud && openapi-ts -f starters/crud/openapi-ts.config.ts",
    "start:crud": "node --env-file-if-exists=.env starters/crud/app.ts",
    "test:crud": "pnpm run generate:crud && pnpm run check && node --test starters/crud/api.test.ts",
    "generate:versions": "tsp compile versions && openapi-ts -f versions/openapi-ts.config.ts",
    "start:versions": "node --env-file-if-exists=.env versions/app.ts",
    "test:versions": "pnpm run generate:versions && node --test versions/api.test.ts",
    "generate:main": "tsp compile . && openapi-ts",
    "generate:webhooks": "tsp compile webhooks && openapi-ts -f webhooks/openapi-ts.config.ts",
    "start:setup": "node --env-file-if-exists=.env starters/setup.ts",
    "migrate": "node --env-file-if-exists=.env scripts/migrate.ts",
    "seed:pagination": "node --env-file-if-exists=.env scripts/seed-pagination.ts",
    "dev": "node --env-file-if-exists=.env --watch src/start.ts",
    "lint": "oxlint .",
    "lint:fix": "oxfmt . && oxlint --fix .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "generate:check": "pnpm run generate && git diff --exit-code -- generated tsp-output starters versions webhooks"
  }
}
