    "ajv-formats": "^3.0.1",
    "better-sqlite3": "^12.10.0",
    "drizzle-orm": "^0.45.2",
    "drizzle-valibot": "^0.4.2",
    "es-toolkit": "^1.46.1",
    "fastify": "^5.8.5",
    "fastify-cli": "^8.0.0",
    "fastify-openapi-glue": "^4.11.2",
    "fastify-plugin": "^5.1.0",
    "npm-check-updates": "^22.2.0",
    "typescript": "^6.0.3",
    "valibot": "^1.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
