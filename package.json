{
  "type": "module",
  "name": "js-fastify-rest-api-example",
  "description": "REST API на Fastify: контракт на TypeSpec, типы и валидация из OpenAPI, Drizzle ORM.",
  "version": "1.0.0",
  "main": "src/app.ts",
  "imports": {
    "#src/*": "./src/*"
  },
  "engines": {
    "node": ">=26"
  },
  "directories": {
    "test": "test"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@fastify/autoload": "^6.5.0",
    "@fastify/cors": "^11.3.0",
    "@fastify/env": "^7.0.0",
    "@fastify/etag": "^6.2.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/jwt": "^10.2.2",
    "@fastify/otel": "^0.20.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/response-validation": "^3.0.4",
    "@fastify/sensible": "^6.0.5",
    "@fastify/under-pressure": "^9.1.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/instrumentation-http": "^0.221.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@scalar/fastify-api-reference": "^1.67.0",
    "@typespec/openapi": "^1.15.0",
    "ajv-formats": "^3.0.1",
    "drizzle-orm": "^0.45.2",
    "es-toolkit": "^1.52.0",
    "fastify": "^5.12.1",
    "fastify-cli": "^8.0.0",
    "fastify-metrics": "^13.2.1",
    "fastify-openapi-glue": "^4.11.4",
    "fastify-plugin": "^6.0.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@hey-api/openapi-ts": "0.99.0",
    "@redocly/cli": "^2.49.0",
    "@stoplight/prism-cli": "^5.16.0",
    "@typespec/compiler": "^1.15.0",
    "@typespec/http": "^1.15.0",
    "@typespec/json-schema": "^1.15.0",
    "@typespec/openapi3": "^1.15.0",
    "@typespec/rest": "^0.85.0",
    "@typespec/versioning": "^0.85.0",
    "@vitest/coverage-v8": "^4.1.11",
    "drizzle-kit": "^0.31.10",
    "globals": "^17.11.0",
    "lefthook": "^2.1.12",
    "npm-check-updates": "^23.1.0",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "pino-pretty": "^13.1.3",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "scripts": {
    "test": "vitest run",
    "start": "NODE_OPTIONS='--import ./src/telemetry.ts' fastify start -l info --plugin-timeout 60000 src/app.ts",
    "dev": "FASTIFY_AUTOLOAD_TYPESCRIPT=1 NODE_OPTIONS='--import ./src/telemetry.ts' fastify start -w -l info -P --plugin-timeout 60000 src/app.ts",
    "lint": "oxlint --config=.oxlintrc.json .",
    "lint:fix": "oxfmt --ignore-path=.oxfmtignore . && oxlint --config=.oxlintrc.json --fix .",
    "format": "oxfmt --ignore-path=.oxfmtignore .",
    "format:check": "oxfmt --ignore-path=.oxfmtignore --check ."
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@11.24.0"
}
