# Скопируйте в .env: `cp .env.example .env`.
# Схема проверяется на старте в plugins/env.ts — без JWT_SECRET приложение не
# поднимется.

# Минимум 32 символа. Сгенерировать: openssl rand -hex 32
JWT_SECRET=replace-me-with-at-least-32-characters

# Необязательные, значения по умолчанию в схеме.
# NODE_ENV=development
# CORS_ORIGIN=*
# RATE_LIMIT_MAX=100
